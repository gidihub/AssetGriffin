# =============================================================================
# Wired up — real code reads these today
# =============================================================================

# Supabase (auth + database) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ or expose it to the browser.
# Only needed for privileged server-side operations that bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used for Supabase signup email confirmation redirect links (app/login/actions.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# =============================================================================
# Scaffolded — client code exists (lib/stripe.ts, lib/resend.ts, lib/openai.ts)
# but nothing calls it yet. Fill these in when you wire up the corresponding
# feature.
# =============================================================================

# Stripe — GriffinEye credit-pack checkout (one-time payments).
# Subscription plan billing is not wired yet; credits use the same Stripe account
# and organizations.stripe_customer_id for future subscription reuse.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time Price IDs from Stripe Dashboard (Product: GriffinEye Scan Credits)
STRIPE_CREDIT_PACK_STARTER_PRICE_ID=
STRIPE_CREDIT_PACK_STANDARD_PRICE_ID=
STRIPE_CREDIT_PACK_BULK_PRICE_ID=

# Brevo — contact form email delivery. The form UI does nothing on submit
# today. See lib/brevo.ts for what's stubbed.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
CONTACT_FORM_TO_EMAIL=hello@assetgriffin.com

# OpenAI — reserved for future GriffinEye extraction (workspace demo is mock-only today).
OPENAI_API_KEY=
GRIFFINEYE_AI_MODEL=gpt-5.4-mini
GRIFFINEYE_VISION_MODEL=gpt-5.4-mini


